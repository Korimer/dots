// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://yalter.github.io/niri/Configuration:-Introduction
include "keybinds.kdl"
include "layout.kdl"
include "window-rules.kdl"

include "plugins/oniri.kdl"
include "plugins/piri.kdl"
include "plugins/animations.kdl"

include optional=true "~/.local/lib/niri/hm-conf.kdl"

input {
    focus-follows-mouse max-scroll-amount="95%"
    keyboard {
        xkb {

        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
        scroll-method "two-finger"
        disabled-on-external-mouse
    }

    mouse {
        // off
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "no-scroll"
    }
}

// kill annoying "heres what commands exist!!!!one! popup
hotkey-overlay {
    skip-at-startup
}

// oh my godddd bruh i picked niri to get AWAY from gnome WHY is middle mouse paste back
clipboard {
    disable-primary
}

// csd = client side decorations
prefer-no-csd

// The path is formatted with strftime(3) to give you the screenshot date and time.
// You can also set this to null to disable saving screenshots to disk.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"


// https://yalter.github.io/niri/Configuration:-Animations
animations {

}

gestures { 
  hot-corners {
    bottom-right
  }
}
